# Copy to /etc/minimax-bot.env and adjust. Do not commit real secrets.
MINIMAX_BOT_HOST=127.0.0.1
MINIMAX_BOT_PORT=8787
MINIMAX_BOT_DATA=/var/lib/minimax-bot
MINIMAX_BOT_CWD=/var/lib/minimax-bot/workspace
MINIMAX_BOT_MCODE=/usr/local/bin/mcode
MINIMAX_BOT_PLUGIN=/opt/MiniMax-Code-MiniApps/plugins/minimax-ai/minimax-bot
# Optional: an OpenAI-compatible model catalog for the Bot settings picker.
# MINIMAX_BOT_MODELS_URL=http://127.0.0.1:3425/v1/models
# MINIMAX_BOT_MODELS_API_KEY=
